{
  "name": "dsh-desktop",
  "version": "1.0.0",
  "description": "DeepSeek Harness 桌面客户端：自动启动服务并打开独立窗口",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "author": "dsh-desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness 桌面版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-桌面版.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
